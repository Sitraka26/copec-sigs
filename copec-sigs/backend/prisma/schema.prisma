// Schéma de base de données - Système de Gestion Scolaire COPEC (Optimisé & Corrigé)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  ADMIN
  DIRECTEUR
  SECRETAIRE
  ECONOME
  ENSEIGNANT
  SURVEILLANT
}

enum Cycle {
  PRESCOLAIRE
  PRIMAIRE
  COLLEGE
  LYCEE
}

enum Sexe {
  MASCULIN
  FEMININ
}

enum StatutInscription {
  ACTIVE
  TRANSFEREE
  ABANDONNEE
  DIPLOMEE
}

enum StatutPresence {
  PRESENT
  ABSENT
  RETARD
  DISPENSE
}

enum StatutPaiement {
  PAYE
  PARTIEL
  EN_ATTENTE
  ANNULE
}

enum StatutReclamationNote {
  OUVERTE
  EN_COURS
  TRAITEE
  REJETEE
}

enum StatutCertificat {
  EN_ATTENTE
  APPROUVE
  REJETE
}

enum TypeDiscipline {
  OBSERVATION_POSITIVE
  OBSERVATION_NEGATIVE
  AVERTISSEMENT
  BLAME
  EXCLUSION_TEMPORAIRE
  AUTRE
}

enum TypeFrais {
  DROIT
  ADIDY
  ECOLAGE
  FRAIS_EXAMEN
  AUTRE
}

// ==========================================
// MODÈLES CORE & UTILISATEURS
// ==========================================

model Etablissement {
  id        String   @id @default(uuid())
  nom       String   // ex: "COPEC Isaha", "COPEC Mangabe"
  adresse   String?
  telephone String?
  email     String?
  logoUrl   String?
  createdAt DateTime @default(now())

  utilisateurs            Utilisateur[]
  anneesScolaires         AnneeScolaire[]
  eleves                  Eleve[]
  classes                 Classe[]
  matieres                Matiere[]
  messages                Message[]
  planificationsScolaires PlanificationScolaire[]
  evenementsScolaires     EvenementScolaire[]
  reclamationsNote        ReclamationNote[]
  auditLogs               AuditLog[]
  disciplines             Discipline[]
  certificatsDemandes     CertificatDemande[]
  emploisDuTemps          EmploiDuTemps[]
  parametresSalaire       ParametreSalaire[]
  presencesEnseignant     PresenceEnseignant[]
  indisponibilites    IndisponibiliteEnseignant[]
}

model Utilisateur {
  id              String   @id @default(uuid())
  etablissementId String
  nom             String
  prenom          String
  email           String   @unique
  motDePasse      String
  role            Role
  actif           Boolean  @default(true)
  createdAt       DateTime @default(now())

  etablissement       Etablissement       @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  enseignant          Enseignant?
  messagesEnvoyes     Message[]           @relation("MessagesEnvoyes")
  messagesRecus       Message[]           @relation("MessagesRecus")
  reclamationsNote    ReclamationNote[]   @relation("ReclamationsAuteur")
  auditLogs           AuditLog[]
  disciplines         Discipline[]        @relation("DisciplineAuteur")
  certificatsDemandes CertificatDemande[] @relation("CertificatsDemandes")
  certificatsValides  CertificatDemande[] @relation("CertificatsValides")
}

model AnneeScolaire {
  id              String   @id @default(uuid())
  etablissementId String
  libelle         String   // ex: "2026-2027"
  dateDebut       DateTime
  dateFin         DateTime
  active          Boolean  @default(false)

  etablissement           Etablissement           @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  inscriptions            Inscription[]
  classes                 Classe[]
  bulletins               Bulletin[]
  baremesFrais            BaremeFrais[]
  paiements               Paiement[]
  planificationsScolaires PlanificationScolaire[]
  evenementsScolaires     EvenementScolaire[]
  emploisDuTemps          EmploiDuTemps[]

  @@unique([etablissementId, libelle])
}

// ==========================================
// ACADÉMIQUE & STRUCTURE
// ==========================================

model Niveau {
  id      String  @id @default(uuid())
  libelle String  // ex: "6ème", "CP", "Terminale"
  cycle   Cycle
  filiere String? // ex: "A1", "A2", "D", "C"
  ordre   Int     // pour le tri (1 à 13)

  classes      Classe[]
  baremesFrais BaremeFrais[]
  programmes   NiveauMatiere[]
}

model Classe {
  id                    String   @id @default(uuid())
  etablissementId       String
  nom                   String   // ex: "6ème A"
  niveauId              String
  anneeScolaireId       String
  enseignantPrincipalId String?

  etablissement           Etablissement           @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  niveau                  Niveau                  @relation(fields: [niveauId], references: [id])
  anneeScolaire           AnneeScolaire           @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade)
  enseignantPrincipal     Enseignant?             @relation("EnseignantPrincipal", fields: [enseignantPrincipalId], references: [id])
  inscriptions            Inscription[]
  emploiDuTemps           EmploiDuTemps[]
  planificationsScolaires PlanificationScolaire[]

  @@unique([etablissementId, nom, anneeScolaireId])
}

model Eleve {
  id                String   @id @default(uuid())
  etablissementId   String
  matricule         String   @unique
  nom               String
  prenom            String
  dateNaissance     DateTime
  sexe              Sexe
  adresse           String?
  photo             String?
  contactUrgenceNom String?
  contactUrgenceTel String?
  informationsSante String?

  // Famille
  pereNom        String?
  pereProfession String?
  mereNom        String?
  mereProfession String?

  // Origine / Transfert
  vientAutreEcole     Boolean @default(false)
  bulletinOrigineUrl  String?
  cycleVise           Cycle?

  // Documents
  photoIdentiteUrl    String?
  extraitNaissanceUrl String?
  carteBaptemeUrl     String?
  createdAt           DateTime @default(now())

  etablissement       Etablissement       @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  inscriptions        Inscription[]
  notes               Note[]
  presences           Presence[]
  paiements           Paiement[]
  bulletins           Bulletin[]
  reclamationsNote    ReclamationNote[]
  disciplines         Discipline[]
  certificatsDemandes CertificatDemande[]
}

model Inscription {
  id              String            @id @default(uuid())
  eleveId         String
  classeId        String
  anneeScolaireId String
  dateInscription DateTime          @default(now())
  statut          StatutInscription @default(ACTIVE)

  eleve         Eleve         @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  classe        Classe        @relation(fields: [classeId], references: [id])
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])
  paiements     Paiement[]

  @@unique([eleveId, anneeScolaireId])
}

model Matiere {
  id              String  @id @default(uuid())
  etablissementId String
  nom             String
  coefficient     Float   @default(1)
  domaine         String? // "SCIENTIFIQUE" | "LITTERAIRE" | null

  etablissement           Etablissement           @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  notes                   Note[]
  emploiDuTemps           EmploiDuTemps[]
  enseignants             EnseignantMatiere[]
  programmes              NiveauMatiere[]
  planificationsScolaires PlanificationScolaire[]
  reclamationsNote        ReclamationNote[]
  presences               Presence[]

  @@unique([etablissementId, nom])
}

model Enseignant {
  id                  String   @id @default(uuid())
  utilisateurId       String   @unique
  telephone           String?
  salaireFixeOverride Float?   // optionnel : fixe perso (sinon paramètre cycle)

  utilisateur     Utilisateur          @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  matieres        EnseignantMatiere[]
  emploiDuTemps   EmploiDuTemps[]
  classesEnCharge Classe[]             @relation("EnseignantPrincipal")
  presences       PresenceEnseignant[]
  cyclePrincipal  Cycle?   // PRESCOLAIRE | PRIMAIRE | COLLEGE | LYCEE
  indisponibilites    IndisponibiliteEnseignant[]
}

model EnseignantMatiere {
  enseignantId String
  matiereId    String

  enseignant Enseignant @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  matiere    Matiere    @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@id([enseignantId, matiereId])
}

model NiveauMatiere {
  id          String @id @default(uuid())
  niveauId    String
  matiereId   String
  coefficient Float

  niveau  Niveau  @relation(fields: [niveauId], references: [id], onDelete: Cascade)
  matiere Matiere @relation(fields: [matiereId], references: [id], onDelete: Cascade)

  @@unique([niveauId, matiereId])
}

// ==========================================
// SALAIRES & PRÉSENCES ENSEIGNANTS
// ==========================================

model ParametreSalaire {
  id                    String   @id @default(uuid())
  etablissementId       String
  // Présco / primaire : montant mensuel fixe
  salaireFixePresco     Float    @default(0)
  salaireFixePrimaire   Float    @default(0)
  // Secondaire : taux horaire (Ar / heure)
  tauxHoraireSecondaire Float    @default(0)
  // Plafond heures / semaine secondaire
  maxHeuresSemaine      Int      @default(6)
  updatedAt             DateTime @updatedAt

  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
}

model PresenceEnseignant {
  id              String   @id @default(uuid())
  etablissementId String
  enseignantId    String
  date            DateTime
  present         Boolean  @default(true)
  heuresPrevues   Float    @default(0) // selon emploi du temps du jour
  heuresFaites    Float    @default(0) // saisies / calculées
  motifAbsence    String?
  createdAt       DateTime @default(now())

  enseignant    Enseignant    @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  @@unique([enseignantId, date])
}

// ==========================================
// ÉVALUATION & SUIVI ACADÉMIQUE
// ==========================================

model Note {
  id        String   @id @default(uuid())
  eleveId   String
  matiereId String
  periode   Int      // 1 à 5 (bimestres)
  valeur    Float
  date      DateTime @default(now())

  eleve   Eleve   @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  matiere Matiere @relation(fields: [matiereId], references: [id])

  @@unique([eleveId, matiereId, periode])
}

model Bulletin {
  id              String   @id @default(uuid())
  eleveId         String
  anneeScolaireId String
  periode         Int      // 1 à 5
  moyenneGenerale Float?
  rang            Int?
  appreciation    String?
  genereLe        DateTime @default(now())

  eleve         Eleve         @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])

  @@unique([eleveId, anneeScolaireId, periode])
}

model ReclamationNote {
  id              String                @id @default(uuid())
  etablissementId String
  auteurId        String
  eleveId         String
  matiereId       String
  periode         Int
  motif           String
  statut          StatutReclamationNote @default(OUVERTE)
  reponse         String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  auteur        Utilisateur   @relation("ReclamationsAuteur", fields: [auteurId], references: [id])
  eleve         Eleve         @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  matiere       Matiere       @relation(fields: [matiereId], references: [id])

  @@index([etablissementId, statut])
  @@index([eleveId, matiereId, periode])
}

model Presence {
  id        String         @id @default(uuid())
  eleveId   String
  matiereId String?        // Optionnel : suivi de présence par cours
  date      DateTime
  statut    StatutPresence
  justifie  Boolean        @default(false)
  motif     String?

  eleve   Eleve    @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  matiere Matiere? @relation(fields: [matiereId], references: [id])

  @@index([eleveId, date])
  minutesRetard  Int?     // null si PRESENT/ABSENT ; > 0 si RETARD
}

// ==========================================
// COMPTABILITÉ & FRAIS
// ==========================================

model BaremeFrais {
  id              String @id @default(uuid())
  niveauId        String
  anneeScolaireId String
  droit           Float  // Frais d'inscription
  adidy           Float  @default(0)
  ecolage         Float  // Écolage annuel
  fraisExamen     Float  @default(0) // Uniquement classes d'examen (3ème, Terminale)

  niveau        Niveau        @relation(fields: [niveauId], references: [id])
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])

  @@unique([niveauId, anneeScolaireId])
}

model Paiement {
  id              String         @id @default(uuid())
  eleveId         String
  inscriptionId   String?
  anneeScolaireId String
  montant         Float
  typeFrais       TypeFrais
  datePaiement    DateTime       @default(now())
  moyenPaiement   String?        // ex: "Espèces", "MVola", "Chèque"
  numeroRecu      String?        @unique
  statut          StatutPaiement @default(PAYE)

  eleve         Eleve         @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  inscription   Inscription?  @relation(fields: [inscriptionId], references: [id])
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])

  @@index([eleveId, anneeScolaireId])
}

// ==========================================
// EMPLOI DU TEMPS & PLANIFICATION
// ==========================================

model EmploiDuTemps {
  id              String @id @default(uuid())
  etablissementId String
  anneeScolaireId String
  classeId        String
  matiereId       String
  enseignantId    String
  jour            Int    // 1=lundi ... 6=samedi
  heureDebut      String // Format "HH:mm"
  heureFin        String // Format "HH:mm"

  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id], onDelete: Cascade)
  classe        Classe        @relation(fields: [classeId], references: [id])
  matiere       Matiere       @relation(fields: [matiereId], references: [id])
  enseignant    Enseignant    @relation(fields: [enseignantId], references: [id])

  @@index([classeId, jour])
}

model PlanificationScolaire {
  id              String    @id @default(uuid())
  etablissementId String
  classeId        String
  matiereId       String
  anneeScolaireId String
  periode         Int?
  titre           String
  objectifs       String?
  contenu         String?
  volumeHoraire   Float?
  statut          String    @default("A_PLANIFIER")
  datePrevue      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  classe        Classe        @relation(fields: [classeId], references: [id])
  matiere       Matiere       @relation(fields: [matiereId], references: [id])
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])

  @@index([etablissementId, classeId, matiereId])
  @@index([anneeScolaireId, periode])
}

model EvenementScolaire {
  id              String    @id @default(uuid())
  etablissementId String
  anneeScolaireId String
  titre           String
  description     String?
  dateDebut       DateTime
  dateFin         DateTime?
  cible           String    @default("TOUS")
  createdAt       DateTime  @default(now())

  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  anneeScolaire AnneeScolaire @relation(fields: [anneeScolaireId], references: [id])

  @@index([etablissementId, dateDebut])
}

// ==========================================
// COMMUNICATION, DISCIPLINE & LOGS
// ==========================================

model Message {
  id                  String   @id @default(uuid())
  etablissementId     String
  expediteurId        String
  destinataireId      String?
  destinataireRole    Role?
  contenu             String
  dateEnvoi           DateTime @default(now())
  luParUtilisateurIds String[] @default([])

  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  expediteur    Utilisateur   @relation("MessagesEnvoyes", fields: [expediteurId], references: [id])
  destinataire  Utilisateur?  @relation("MessagesRecus", fields: [destinataireId], references: [id])
}

model AuditLog {
  id              String   @id @default(uuid())
  etablissementId String
  utilisateurId   String?
  action          String   // ex: "CREATE_ELEVE", "UPDATE_NOTE", "LOGIN"
  entite          String?  // ex: "Eleve", "Note", "Paiement"
  entiteId        String?
  details         String?  // JSON ou texte
  ip              String?
  createdAt       DateTime @default(now())

  utilisateur   Utilisateur?  @relation(fields: [utilisateurId], references: [id])
  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
}

model Discipline {
  id              String         @id @default(uuid())
  etablissementId String
  eleveId         String
  auteurId        String
  type            TypeDiscipline
  motif           String
  description     String?
  dateIncident    DateTime       @default(now())
  points          Int            @default(0)
  createdAt       DateTime       @default(now())

  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  eleve         Eleve         @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  auteur        Utilisateur   @relation("DisciplineAuteur", fields: [auteurId], references: [id])

  @@index([eleveId, dateIncident])
  @@index([etablissementId])
}

model IndisponibiliteEnseignant {
  id              String   @id @default(uuid())
  etablissementId String
  enseignantId    String
  jour            Int      // 1=lundi ... 6=samedi
  heureDebut      String   // "HH:mm"
  heureFin        String
  motif           String?  // "Autre école", etc.
  createdAt       DateTime @default(now())

  enseignant    Enseignant    @relation(fields: [enseignantId], references: [id], onDelete: Cascade)
  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)

  @@index([enseignantId, jour])
}

model CertificatDemande {
  id              String           @id @default(uuid())
  etablissementId String
  eleveId         String
  demandeurId     String
  type            String           // SCOLARITE | ASSIDUITE | REUSSITE
  statut          StatutCertificat @default(EN_ATTENTE)
  motifRejet      String?
  valideParId     String?
  createdAt       DateTime         @default(now())
  valideLe        DateTime?

  etablissement Etablissement @relation(fields: [etablissementId], references: [id], onDelete: Cascade)
  eleve         Eleve         @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  demandeur     Utilisateur   @relation("CertificatsDemandes", fields: [demandeurId], references: [id])
  validePar     Utilisateur?  @relation("CertificatsValides", fields: [valideParId], references: [id])

  @@index([eleveId, createdAt])
  @@index([etablissementId, statut])
}